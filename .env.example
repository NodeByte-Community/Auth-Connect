# NodeByte Connect - SSO System Environment Configuration Example
# Copy to .env and fill in your real values

# Server
PORT=3000
BASE_URL=https://connect.nodebyte.cn

# NodeByte SSO (Discourse Connect Provider)
DISCOURSE_BASE_URL=https://bbs.nodebyte.cn
DISCOURSE_CONNECT_URL=https://bbs.nodebyte.cn/session/sso_provider
DISCOURSE_CONNECT_SECRET=your_sso_shared_secret_here

# Discourse API (for site messages / user status checks)
DISCOURSE_API_KEY=your_discourse_api_key_here
DISCOURSE_API_USERNAME=system

# JWT (for OIDC id_token signing)
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1h

# Session
SESSION_SECRET=generate_another_random_string
SESSION_TIMEOUT_MIN=720

# Admin group name in Discourse (users in this group are admins)
ADMIN_GROUP_NAME=admins

# Admin trust level threshold (users at or above this trust level are also admins)
ADMIN_TRUST_LEVEL=4

# Banned user check interval (minutes) - for cron job
BANNED_CHECK_INTERVAL=5

# Cron job shared key (for /api/cron/check-banned)
CRON_KEY=generate_a_random_secret

# Cookie
COOKIE_SECURE=true

# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Placeholders below - replace with your real MySQL credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nbconnect
DB_USER=root
DB_PASSWORD=your_password_here
DATABASE_URL=mysql://root:your_password_here@127.0.0.1:3306/nbconnect
