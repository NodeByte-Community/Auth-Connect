// NodeByte Connect - SSO System Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  externalId      String   @unique // Discourse user ID
  email           String
  username        String
  name            String?
  avatarUrl       String?
  bio             String?
  trustLevel      Int      @default(0) // Discourse trust level 0-4
  isAdmin         Boolean  @default(false)
  isModerator     Boolean  @default(false)
  isBanned        Boolean  @default(false)
  isSuspended     Boolean  @default(false)
  appSubmitBlocked Boolean @default(false) // admin can block user from submitting apps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?

  applications    Application[]
  reviews         AppReview[]      @relation("ReviewerReviews")
  logs            UserLog[]
  authCodes       AuthCode[]
  accessTokens    AccessToken[]
  sessions        Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique // session cookie token
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  pendingAuthorize String? // pending oauth authorize URL to redirect to after login
}

model Application {
  id            String       @id @default(cuid())
  appId         String       @unique // public app identifier (nb_xxx)
  name          String
  icon          String?
  description   String
  type          String       // "oidc" | "oauth2"
  callbackUrls  String       // newline-separated
  status        String       @default("pending") // pending, approved, rejected, disabled, pending_re_review
  rejectReason  String?
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clientSecret  String
  scopes        String       @default("openid profile email")
  siteLogo      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  reviewedAt    DateTime?
  reviewerId    String?

  reviews       AppReview[]
  authCodes     AuthCode[]
  accessTokens  AccessToken[]
  verifyCodes   VerificationCode[]
}

model AppReview {
  id           String    @id @default(cuid())
  appId        String
  app          Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  status       String    // pending, approved, rejected
  reason       String?
  reviewerId   String?
  reviewer     User?     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}

model VerificationCode {
  id           String   @id @default(cuid())
  appId        String
  app          Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  code         String
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model AuthCode {
  id           String   @id @default(cuid())
  code         String   @unique
  appId        String
  app          Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  redirectUri  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  used         Boolean  @default(false)
}

model AccessToken {
  id           String   @id @default(cuid())
  token        String   @unique
  refreshToken String?  @unique
  appId        String
  app          Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model UserLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  details      String?
  ip           String?
  createdAt    DateTime @default(now())
}

model SystemSettings {
  id           String   @id @default("default")
  maxAppsPerUser     Int    @default(5)
  minTrustLevel      Int    @default(1)
  notifyOnSubmit     Boolean @default(true)
  notifyOnApprove    Boolean @default(true)
  notifyOnReject     Boolean @default(true)
  notifyOnFail       Boolean @default(true)
  sessionTimeoutMin  Int    @default(720) // 12 hours
  updatedAt    DateTime @updatedAt
}
